<?xml version="1.0" encoding="utf-8"?>
<!--
  NuGet configuration for the .NET Linux layout test.

  This test runs on the same Windows VM that just produced the Microsoft.SymCrypt
  .nupkg. The "Local" source value (".") is the nuget.config location; the
  pipeline drops a copy of the freshly-built .nupkg next to this file before
  invoking dotnet publish so that restore can locate it.

  SymCrypt.NuGet is the upstream feed used by the build container; it proxies the
  Microsoft .NET SDK reference packs needed by framework-dependent `dotnet publish`
  with a Linux RuntimeIdentifier (`linux-x64`, `linux-arm64`) for the net8.0 target.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="Local" value="." />
    <add key="SymCrypt.NuGet" value="https://microsoft.pkgs.visualstudio.com/_packaging/SymCrypt.NuGet/nuget/v3/index.json" />
  </packageSources>
</configuration>
